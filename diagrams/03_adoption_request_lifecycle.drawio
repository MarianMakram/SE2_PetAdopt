<mxfile host="app.diagrams.net" modified="2026-05-10T00:00:00.000Z" agent="PetAdopt" version="24.0.0" type="device">
  <diagram id="adoption-lifecycle" name="Adoption Request Lifecycle">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Request Lifecycle — User Clicks &quot;Adopt This Pet&quot;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="480" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 1 ===== -->
        <mxCell id="step1" value="&lt;b&gt;① User Clicks &quot;Adopt&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;PetDetailsPage.jsx&lt;br&gt;onClick → apiClient.post(...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;fontColor=#fff;strokeColor=#2E7D32;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 2 ===== -->
        <mxCell id="step2" value="&lt;b&gt;② Axios Interceptor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Reads localStorage('accessToken')&lt;br&gt;Attaches: Authorization: Bearer xxx&lt;br&gt;POST /api/adoption-requests&lt;br&gt;Body: { petId: 5 }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#fff;strokeColor=#388E3C;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" source="step1" target="step2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 3 ===== -->
        <mxCell id="step3" value="&lt;b&gt;③ API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 8080&lt;br&gt;Route: /api/adoption-requests/**&lt;br&gt;→ adoption-service (via Eureka lb)&lt;br&gt;Passes Authorization header through&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6F00;fontColor=#fff;strokeColor=#E65100;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a23" value="&lt;font style=&quot;font-size:9px;&quot;&gt;HTTP POST&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FF6F00;fontColor=#E65100;" edge="1" source="step2" target="step3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 4 ===== -->
        <mxCell id="step4" value="&lt;b&gt;④ JWT Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;JwtAuthenticationFilter runs:&lt;br&gt;• Extract Bearer token&lt;br&gt;• Verify HMAC-SHA256 signature&lt;br&gt;• Check expiry (15 min window)&lt;br&gt;• Extract email from &apos;sub&apos; claim&lt;br&gt;• Set SecurityContext → authenticated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#fff;strokeColor=#0D47A1;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="220" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" source="step3" target="step4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 5 ===== -->
        <mxCell id="step5" value="&lt;b&gt;⑤ AdoptionController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Receives validated request&lt;br&gt;Extracts userId from JWT claims&lt;br&gt;Calls service layer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976D2;fontColor=#fff;strokeColor=#0D47A1;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="390" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" source="step4" target="step5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 6: FEIGN ===== -->
        <mxCell id="step6" value="&lt;b&gt;⑥ OpenFeign Call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;@FeignClient(&quot;pet-service&quot;)&lt;br&gt;GET /api/pets/5&lt;br&gt;&quot;Is this pet AVAILABLE?&quot;&lt;br&gt;&lt;br&gt;Eureka resolves &apos;pet-service&apos;&lt;br&gt;→ 172.18.0.x:8081&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF6C00;fontColor=#fff;strokeColor=#E65100;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="220" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a56" value="&lt;font style=&quot;font-size:9px;color:#D32F2F;&quot;&gt;&lt;b&gt;Feign HTTP&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#D32F2F;dashed=1;dashPattern=8 4;" edge="1" source="step5" target="step6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 7: Pet DB ===== -->
        <mxCell id="step7" value="&lt;b&gt;⑦ Pet Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Queries petdb&lt;br&gt;SELECT * FROM pets WHERE id=5&lt;br&gt;Returns: { status: &quot;AVAILABLE&quot; }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF6C00;fontColor=#fff;strokeColor=#E65100;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="220" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" source="step6" target="step7" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Feign response back -->
        <mxCell id="a76" value="&lt;font style=&quot;font-size:9px;&quot;&gt;✅ AVAILABLE&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2E7D32;dashed=1;fontColor=#2E7D32;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="320" as="sourcePoint"/>
            <mxPoint x="970" y="320" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== STEP 8: SAVE ===== -->
        <mxCell id="step8" value="&lt;b&gt;⑧ Save Adoption&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;AdoptionRequest entity:&lt;br&gt;petId=5, adopterId=42&lt;br&gt;status=PENDING&lt;br&gt;INSERT INTO adoptiondb.adoptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#fff;strokeColor=#0D47A1;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="390" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" source="step6" target="step8" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="370"/>
              <mxPoint x="865" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== STEP 9: NOTIFICATION ===== -->
        <mxCell id="step9" value="&lt;b&gt;⑨ Notification (Optional)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Feign → Interaction Service&lt;br&gt;POST /api/notifications&lt;br&gt;{ userId, message }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;fontColor=#fff;strokeColor=#004D40;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a89" value="&lt;font style=&quot;font-size:9px;color:#D32F2F;&quot;&gt;Feign&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#D32F2F;dashed=1;dashPattern=8 4;fontColor=#D32F2F;" edge="1" source="step8" target="step9" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 10: RESPONSE ===== -->
        <mxCell id="step10" value="&lt;b&gt;⑩ HTTP 201 Created&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;{ id: 101, status: &quot;PENDING&quot;, petId: 5 }&lt;br&gt;Flows back: Adoption → Gateway → React&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="540" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a910" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#43A047;" edge="1" source="step8" target="step10" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 11: UI UPDATE ===== -->
        <mxCell id="step11" value="&lt;b&gt;⑪ React UI Updates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Shows success toast:&lt;br&gt;&quot;Application Submitted!&quot;&lt;br&gt;Button changes to &quot;Pending&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;fontColor=#fff;strokeColor=#2E7D32;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a1011" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" source="step10" target="step11" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== AOP BOX ===== -->
        <mxCell id="aop-box" value="&lt;b&gt;🔍 AOP Logging (runs at every step)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;@Before: logs method name + arguments&lt;br&gt;@AfterReturning: logs return value + execution time&lt;br&gt;Applies to all controller methods via common-logging module&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;shadow=1;fontSize=10;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="750" y="540" width="340" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== EMPLOYEE REVIEW (Phase 2) ===== -->
        <mxCell id="phase2-label" value="&lt;b&gt;LATER: Employee Reviews Application&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFECB3;fontSize=11;fontColor=#E65100;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="260" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="review-flow" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Submitted&lt;/b&gt; → &lt;b&gt;Under Review&lt;/b&gt; → &lt;b&gt;Approved&lt;/b&gt; → Pet status changes to &quot;Adopted&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;↘ &lt;b&gt;Rejected&lt;/b&gt; → Pet stays &quot;Available&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="520" height="50" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
