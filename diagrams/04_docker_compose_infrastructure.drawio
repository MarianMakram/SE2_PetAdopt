<mxfile host="app.diagrams.net" modified="2026-05-10T00:00:00.000Z" agent="PetAdopt" version="24.0.0" type="device">
  <diagram id="docker-infra" name="Docker Compose Infrastructure">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Docker Compose — Container Startup Order &amp; Dependencies&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="320" y="10" width="530" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 1: DATABASE ===== -->
        <mxCell id="layer1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="layer1-label" value="&lt;b&gt;LAYER 1 — Starts First (no dependencies)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="50" y="73" width="270" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="postgres" value="&lt;b&gt;🐘 postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;image: postgres:15&lt;br&gt;container: petadopt-db&lt;br&gt;Port: 5432:5432&lt;br&gt;Databases: authdb, petdb,&lt;br&gt;adoptiondb, interactiondb&lt;br&gt;User: odoo / Pass: odoo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D32F2F;fontColor=#fff;strokeColor=#B71C1C;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="200" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="init-script" value="&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;b&gt;init-multiple-databases.sh&lt;/b&gt;&lt;br&gt;Creates all 4 databases on first start&lt;br&gt;&lt;br&gt;&lt;b&gt;seed.sql&lt;/b&gt;&lt;br&gt;Inserts test users &amp; pet data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="780" y="95" width="220" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="a-init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#C62828;dashed=1;" edge="1" source="postgres" target="init-script" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 2: EUREKA ===== -->
        <mxCell id="layer2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="layer2-label" value="&lt;b&gt;LAYER 2 — Starts Second (no depends_on)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="50" y="223" width="290" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="eureka" value="&lt;b&gt;🔭 eureka-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;build: ./backend/eureka-server&lt;br&gt;Port: 8761:8761&lt;br&gt;Healthcheck: wget /actuator/health&lt;br&gt;Interval: 30s, Retries: 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B1FA2;fontColor=#fff;strokeColor=#4A148C;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="health-note" value="&lt;font style=&quot;font-size:9px;&quot;&gt;⚕️ &lt;b&gt;Healthcheck is critical!&lt;/b&gt;&lt;br&gt;All services wait for Eureka to be&lt;br&gt;&lt;b&gt;service_healthy&lt;/b&gt; before starting.&lt;br&gt;Without it, services would crash&lt;br&gt;trying to register with Eureka&lt;br&gt;before it&apos;s ready.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="230" height="75" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 3: MICROSERVICES ===== -->
        <mxCell id="layer3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="1320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="layer3-label" value="&lt;b&gt;LAYER 3 — Start Together (depends_on: eureka [healthy] + postgres [started])&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="50" y="373" width="520" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="auth-svc" value="&lt;b&gt;auth-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 8082&lt;br&gt;DB: authdb&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;fontColor=#fff;strokeColor=#B71C1C;strokeWidth=2;shadow=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pet-svc" value="&lt;b&gt;pet-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 8081&lt;br&gt;DB: petdb&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF6C00;fontColor=#fff;strokeColor=#E65100;strokeWidth=2;shadow=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="400" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="adopt-svc" value="&lt;b&gt;adoption-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 8083&lt;br&gt;DB: adoptiondb&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#fff;strokeColor=#0D47A1;strokeWidth=2;shadow=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="400" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="interact-svc" value="&lt;b&gt;interaction-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 8084&lt;br&gt;DB: interactiondb&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;fontColor=#fff;strokeColor=#004D40;strokeWidth=2;shadow=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="400" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="env-note" value="&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;b&gt;Environment Variables (injected by Docker):&lt;/b&gt;&lt;br&gt;SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/&amp;lt;db&amp;gt;&lt;br&gt;EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/&lt;br&gt;No hardcoded IPs anywhere — Docker DNS resolves container names!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1030" y="395" width="310" height="70" as="geometry"/>
        </mxCell>

        <!-- Dependency arrows -->
        <mxCell id="dep1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#C62828;exitX=0.5;exitY=1;entryX=0.25;entryY=0;strokeColor=#7B1FA2;" edge="1" source="eureka" target="layer3-bg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="dep2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#C62828;exitX=0.5;exitY=1;entryX=0.75;entryY=0;strokeColor=#C62828;" edge="1" source="postgres" target="layer3-bg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 4: API GATEWAY ===== -->
        <mxCell id="layer4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6F00;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="1320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="layer4-label" value="&lt;b&gt;LAYER 4 — Starts After Eureka is Healthy (depends_on: eureka [healthy])&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#FF6F00;" vertex="1" parent="1">
          <mxGeometry x="50" y="553" width="480" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="gw-svc" value="&lt;b&gt;api-gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 8080:8080 — Single entry point for React&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6F00;fontColor=#fff;strokeColor=#E65100;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="575" width="320" height="45" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 5: FRONTEND ===== -->
        <mxCell id="layer5-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="layer5-label" value="&lt;b&gt;LAYER 5 — Starts Last (depends_on: api-gateway)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#43A047;" vertex="1" parent="1">
          <mxGeometry x="50" y="683" width="340" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="fe-svc" value="&lt;b&gt;petadopt-frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Port 3000:80 — Nginx serves built React app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;fontColor=#fff;strokeColor=#2E7D32;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="700" width="320" height="35" as="geometry"/>
        </mxCell>

        <!-- Layer arrows -->
        <mxCell id="dep-gw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#7B1FA2;" edge="1" source="layer3-bg" target="layer4-bg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="dep-fe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FF6F00;" edge="1" source="layer4-bg" target="layer5-bg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Command -->
        <mxCell id="cmd-box" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;🚀 One command to start everything:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:monospace;&quot;&gt;docker-compose up --build&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;📦 Then seed the database:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:monospace;&quot;&gt;docker exec -i petadopt-db psql -U odoo -d authdb &amp;lt; seed.sql&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;strokeWidth=2;shadow=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="560" width="310" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
