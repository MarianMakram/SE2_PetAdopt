<mxfile host="app.diagrams.net" modified="2026-05-10T00:00:00.000Z" agent="PetAdopt" version="24.0.0" type="device">
  <diagram id="dev6-role" name="Developer 6 — Frontend Integration Role">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Developer 6 — Frontend Integration: 5-Step Implementation&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="320" y="10" width="540" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 1: AUDIT ===== -->
        <mxCell id="s1" value="&lt;b&gt;STEP 1: Audit React Codebase&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#fff;strokeColor=#0D47A1;strokeWidth=2;shadow=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s1-detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• Mapped all 11 page components in &lt;b&gt;src/pages/&lt;/b&gt;&lt;br&gt;• Found 2 context providers (Auth + Notification)&lt;br&gt;• Identified centralized &lt;b&gt;apiClient.js&lt;/b&gt; in src/services/&lt;br&gt;• Documented all API endpoints used across pages&lt;br&gt;• Found role-guard component: &lt;b&gt;ProtectedRoute.jsx&lt;/b&gt;&lt;br&gt;• Identified shared UI: &lt;b&gt;Navbar.jsx&lt;/b&gt; with role-based menus&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="340" height="105" as="geometry"/>
        </mxCell>

        <!-- Files found -->
        <mxCell id="s1-files" value="&lt;font style=&quot;font-size:9px;font-family:monospace;&quot;&gt;&lt;b&gt;Files Audited:&lt;/b&gt;&lt;br&gt;src/services/apiClient.js&lt;br&gt;src/context/AuthContext.jsx&lt;br&gt;src/context/NotificationContext.jsx&lt;br&gt;src/components/shared/ProtectedRoute.jsx&lt;br&gt;src/components/shared/Navbar.jsx&lt;br&gt;src/pages/Login.jsx&lt;br&gt;src/pages/Register.jsx&lt;br&gt;src/pages/BrowsePetsPage.jsx&lt;br&gt;src/pages/PetDetailsPage.jsx&lt;br&gt;src/pages/FavoritesPage.jsx&lt;br&gt;src/pages/AdopterRequestsPage.jsx&lt;br&gt;src/pages/UserApprovalsPage.jsx&lt;br&gt;+ 4 owner-admin pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1;align=left;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="230" height="180" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 2: REFACTOR API ===== -->
        <mxCell id="s2" value="&lt;b&gt;STEP 2: Refactor API Calls&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF6C00;fontColor=#fff;strokeColor=#E65100;strokeWidth=2;shadow=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s2-detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Created centralized apiClient.js:&lt;/b&gt;&lt;br&gt;• baseURL = &apos;http://localhost:8080/api&apos;&lt;br&gt;• All pages import from one file&lt;br&gt;• No direct service URLs anywhere&lt;br&gt;&lt;br&gt;&lt;b&gt;Route mapping enforced:&lt;/b&gt;&lt;br&gt;/auth/** → Auth Service (8082)&lt;br&gt;/pets/** → Pet Service (8081)&lt;br&gt;/adoption-requests/** → Adoption (8083)&lt;br&gt;/favorites/** → Interaction (8084)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="340" height="155" as="geometry"/>
        </mxCell>

        <!-- Before/After -->
        <mxCell id="s2-before" value="&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;b&gt;❌ BEFORE (Wrong):&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:monospace;&quot;&gt;fetch(&apos;http://localhost:8081/api/pets&apos;)&lt;br&gt;fetch(&apos;http://localhost:8082/api/auth/login&apos;)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;✅ AFTER (Correct):&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:monospace;&quot;&gt;apiClient.get(&apos;/pets&apos;)&lt;br&gt;apiClient.post(&apos;/auth/login&apos;, creds)&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1;align=left;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="260" height="130" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 3: JWT STATE ===== -->
        <mxCell id="s3" value="&lt;b&gt;STEP 3: JWT State Management&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B1FA2;fontColor=#fff;strokeColor=#4A148C;strokeWidth=2;shadow=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s3-detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;AuthContext.jsx provides:&lt;/b&gt;&lt;br&gt;• login(email, password) → stores JWT&lt;br&gt;• logout() → clears all tokens&lt;br&gt;• validateSession() → calls /auth/me on mount&lt;br&gt;• user object available via useAuth() hook&lt;br&gt;&lt;br&gt;&lt;b&gt;Storage: localStorage&lt;/b&gt;&lt;br&gt;• accessToken (JWT, 15min expiry)&lt;br&gt;• refreshToken (placeholder for now)&lt;br&gt;• user (JSON: id, email, role, name)&lt;br&gt;&lt;br&gt;&lt;b&gt;Auto-attach via Axios interceptor:&lt;/b&gt;&lt;br&gt;Every request gets Authorization: Bearer xxx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="115" width="300" height="195" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 4: ERROR HANDLING ===== -->
        <mxCell id="s4" value="&lt;b&gt;STEP 4: Error Handling&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;fontColor=#fff;strokeColor=#B71C1C;strokeWidth=2;shadow=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="330" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s4-detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Response Interceptor handles:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;401&lt;/b&gt; → Try refresh token → if fails, redirect /login&lt;br&gt;• &lt;b&gt;403&lt;/b&gt; → Redirect to /unauthorized page&lt;br&gt;• &lt;b&gt;404&lt;/b&gt; → Show &quot;Not Found&quot; in component&lt;br&gt;• &lt;b&gt;400&lt;/b&gt; → Display validation message from Spring&lt;br&gt;• &lt;b&gt;500&lt;/b&gt; → Show generic error banner&lt;br&gt;• &lt;b&gt;Network Error&lt;/b&gt; → &quot;Backend not running&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;Spring Boot error format:&lt;/b&gt;&lt;br&gt;{ timestamp, status, error, &lt;b&gt;message&lt;/b&gt;, path }&lt;br&gt;Interceptor extracts &amp;apos;message&amp;apos; field for UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="375" width="300" height="190" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 5: E2E TESTING ===== -->
        <mxCell id="s5" value="&lt;b&gt;STEP 5: End-to-End Testing&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#fff;strokeColor=#1B5E20;strokeWidth=2;shadow=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="590" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s5-detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Test against Docker Compose environment:&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ Register as Adopter → JWT stored&lt;br&gt;✅ Login (ahmed@example.com / password123)&lt;br&gt;✅ Browse pets → cards load from Pet Service&lt;br&gt;✅ Click Adopt → POST to /adoption-requests&lt;br&gt;✅ Check Favorites → add/remove works&lt;br&gt;✅ Role guard → /shelter/* blocked for Adopter&lt;br&gt;✅ Token expiry → auto-refresh or redirect&lt;br&gt;✅ Admin panel → user approvals list&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="635" width="300" height="155" as="geometry"/>
        </mxCell>

        <!-- ===== COVER SHEET BOX ===== -->
        <mxCell id="cover" value="&lt;b&gt;📋 Cover Sheet Contributions&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Implementation (APIs)&lt;/b&gt; — 4 pts ⭐&lt;br&gt;I wrote all apiClient calls connecting React to 4 services&lt;br&gt;&lt;br&gt;&lt;b&gt;Microservices &amp; Cloud&lt;/b&gt; — 3 pts&lt;br&gt;Enforced gateway-only access pattern in frontend&lt;br&gt;&lt;br&gt;&lt;b&gt;Clean Code&lt;/b&gt; — 2 pts&lt;br&gt;Centralized apiClient.js + AuthContext pattern&lt;br&gt;&lt;br&gt;&lt;b&gt;Docker&lt;/b&gt; — 2 pts&lt;br&gt;Updated frontend Dockerfile + tested in compose&lt;br&gt;&lt;br&gt;&lt;b&gt;SRS Diagrams&lt;/b&gt; — 2 pts&lt;br&gt;Contributed sequence diagrams from user perspective&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;shadow=1;align=left;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="340" height="250" as="geometry"/>
        </mxCell>

        <!-- Connecting arrows between steps -->
        <mxCell id="flow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#1565C0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#EF6C00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="s2" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="290"/>
              <mxPoint x="660" y="90"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#7B1FA2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s3" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#C62828;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s4" target="s5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
